{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "de.felitendo.obs-tools",
	"Name": "OBS Tools",
	"Version": "0.2.1",
	"Author": "Felitendo",
	"Description": "Advanced OBS tools for OpenDeck on Linux and macOS: smart scene switching with previews, source animations, instant replay, video player, dropped frame alarm and more.",
	"URL": "https://github.com/FeloDeck/obs-tools",
	"Icon": "images/plugin",
	"Category": "OBS Tools",
	"CategoryIcon": "images/category",
	"CodePath": "bin/x86_64-unknown-linux-gnu/obs-tools",
	"CodePaths": {
		"x86_64-unknown-linux-gnu": "bin/x86_64-unknown-linux-gnu/obs-tools",
		"aarch64-unknown-linux-gnu": "bin/aarch64-unknown-linux-gnu/obs-tools",
		"x86_64-apple-darwin": "bin/x86_64-apple-darwin/obs-tools",
		"aarch64-apple-darwin": "bin/aarch64-apple-darwin/obs-tools"
	},
	"PropertyInspectorPath": "pi/index.html",
	"SDKVersion": 2,
	"OS": [
		{
			"Platform": "linux"
		},
		{
			"Platform": "mac"
		}
