{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
	"id": "obstools-volume-meter",
	"items": [
		{ "key": "title", "type": "text", "rect": [16, 8, 168, 22], "font": { "size": 16, "weight": 600 }, "alignment": "left" },
		{ "key": "icon", "type": "pixmap", "rect": [16, 38, 40, 40] },
