		{ "key": "indicator", "type": "bar", "rect": [64, 66, 120, 10], "value": 0, "subtype": 4, "border_w": 0, "bar_bg_c": "#3A3A3A", "bar_fill_c": "#30A46C" },
		{ "key": "meter", "type": "bar", "rect": [64, 82, 120, 6], "value": 0, "subtype": 0, "border_w": 0, "bar_bg_c": "#2A2A2A", "bar_fill_c": "0:#30A46C,0.85:#30A46C,0.851:#F5A524,0.95:#F5A524,0.951:#E5484D,1:#E5484D" }
